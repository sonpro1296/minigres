# Copy to lab/.env on the lab host and change both passwords. Never commit .env.
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me-too
LAB_SUBNET=172.28.0.0/24
# 127.0.0.1 = reachable only via SSH tunnel (safe default).
# 0.0.0.0   = Postgres reachable from the internet if the cloud firewall allows it.
LAB_BIND_IP=127.0.0.1
